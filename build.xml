<?xml version="1.0" encoding="UTF-8"?>
<project name="MJCompiler" basedir=".">
	
	
	<target name="delete">
		<delete>
			<fileset dir="src/rs/ac/bg/etf/pp1">
				<exclude name="util/Log4JUtils.java"/>
				<exclude/>
			</fileset>
		</delete>
	</target>
		
	<target name="lexerGen" depends="delete">
		<java jar="lib/JFlex.jar" fork="true">
			<arg value="-d"/>
			<arg value="./src/rs/ac/bg/etf/pp1"/>
			<arg value="src/spec/mjlexer.flex"/>
		</java>	
	</target>
	
	<target name="parserGen" depends="lexerGen">
		<java jar="lib/cup_v10k.jar" fork="true">
			<arg value="-destdir"/>
			<arg value="src/rs/ac/bg/etf/pp1"/>
			<arg value="-ast"/>
			<arg value="src.rs.ac.bg.etf.pp1.ast"/>
			<arg value="-parser"/>
			<arg value="MJParser"/>
			<!--<arg value="-dump_states"/>-->
			<arg value="-buildtree"/>
			<arg value="src/spec/mjparser.cup"/>
		</java>	
	</target>
	
	<target name="repackage" depends="parserGen">
		<replace dir="src" value="rs.ac.bg.etf.pp1.ast" token="src.rs.ac.bg.etf.pp1.ast" summary="true" />
	</target>
	
	<!-- source/target 1.8 su eksplicitni da bi prevedene klase radile na
	     laboratorijskim masinama i onda kada se Ant slucajno pokrene na novijem JDK-u. -->
	<target name="compile" depends="repackage">
		<javac includeantruntime="false" source="1.8" target="1.8">
			<!-- generisani lekser, parser i AST -->
			<src path="src/rs/ac/bg/etf/pp1"/>
			<!-- rucno pisane klase: Compiler i TestRunner -->
			<src path="test"/>
			<classpath>
				<pathelement path="lib/JFlex.jar"/>
				<pathelement path="lib/cup_v10k.jar"/>
				<pathelement path="lib/log4j-1.2.17.jar"/>
			</classpath>
		</javac>
	</target>

	<!-- Pokretanje svih testova iz test foldera. Za svaki .mj fajl pravi
	     istoimeni .out (standardni izlaz) i .err (izlaz gresaka). -->
	<target name="test" depends="compile">
		<java classname="rs.ac.bg.etf.pp1.TestRunner" fork="true" failonerror="true">
			<classpath>
				<pathelement path="src"/>
				<pathelement path="test"/>
				<pathelement path="config"/>
				<pathelement path="lib/cup_v10k.jar"/>
				<pathelement path="lib/log4j-1.2.17.jar"/>
			</classpath>
		</java>
	</target>
	
</project>	