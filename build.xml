<?xml version="1.0" encoding="UTF-8"?>
<project name="MJCompiler" basedir=".">
	
	
	<!-- Svi jarovi iz lib/ odjednom. Nabrajanje jar po jar je vec jednom omaslo
	     (symboltable-1-1.jar je nedostajao), a lib/ ce dobiti jos i mj-runtime-1.1.jar
	     za generisanje koda - ovako ga ne treba nigde dopisivati. -->
	<path id="project.classpath">
		<fileset dir="lib" includes="*.jar"/>
	</path>

	<!-- Provera koji JDK zapravo pokrece build. Postavka trazi jdk 1.8.
	     Pokrenuti sa: ant jdkinfo -->
	<target name="jdkinfo">
		<echo>java.version = ${java.version}</echo>
		<echo>java.home    = ${java.home}</echo>
		<echo>java.vendor  = ${java.vendor}</echo>
	</target>

	<!-- Brise sve prevedene klase. Isto sto i Project -> Clean u Eclipse-u.
	     Pokrenuti sa: ant clean   (pa zatim F5 na projektu u Eclipse-u) -->
	<target name="clean">
		<delete dir="bin"/>
		<delete>
			<fileset dir="src" includes="**/*.class"/>
			<fileset dir="test" includes="**/*.class"/>
			<fileset dir="config" includes="**/*.class"/>
		</delete>
	</target>

	<target name="delete">
		<delete>
			<fileset dir="src/rs/ac/bg/etf/pp1">
				<exclude name="util/Log4JUtils.java"/><exclude/>
				<exclude name="SemanticAnalyzer.java"/><exclude/>
				<exclude name="MyTab.java"/><exclude/>
				<exclude name="MyDumpSymbolTableVisitor.java"/><exclude/>
				<exclude name="CodeGenerator.java"/><exclude/>
			</fileset>
		</delete>
	</target>
		
	<target name="lexerGen" depends="delete">
		<java jar="lib/JFlex.jar" fork="true">
			<arg value="-d"/>
			<arg value="./src/rs/ac/bg/etf/pp1"/>
			<arg value="src/spec/mjlexer.flex"/>
		</java>	
	</target>
	
	<target name="parserGen" depends="lexerGen">
		<java jar="lib/cup_v10k.jar" fork="true">
			<arg value="-destdir"/>
			<arg value="src/rs/ac/bg/etf/pp1"/>
			<arg value="-ast"/>
			<arg value="src.rs.ac.bg.etf.pp1.ast"/>
			<arg value="-parser"/>
			<arg value="MJParser"/>
			<!--<arg value="-dump_states"/>-->
			<arg value="-buildtree"/>
			<arg value="src/spec/mjparser.cup"/>
		</java>	
	</target>
	
	<target name="repackage" depends="parserGen">
		<replace dir="src" value="rs.ac.bg.etf.pp1.ast" token="src.rs.ac.bg.etf.pp1.ast" summary="true" />
	</target>
	
	<!-- release="8" umesto source/target: pored sintakse i verzije bajtkoda,
	     ogranicava i STANDARDNU BIBLIOTEKU na ono sto je postojalo u Javi 8.
	     Time upotreba API-ja novijeg od 8 puca ovde, a ne tek na laboratorijskoj masini.
	     Eclipse-ov Ant zahteva Javu 11+ pa se ne moze pokrenuti na samom JDK 8;
	     ovo je nacin da se i pored toga prevodi ispravno za 8.
	     Napomena: release i source/target se medjusobno iskljucuju. -->
	<target name="compile" depends="repackage">
		<echo>Prevodim sa Java ${java.version} (${java.home})</echo>
		<mkdir dir="bin"/>
		<!-- destdir je obavezan: bez njega javac pise .class fajlove pored .java,
		     dakle unutar Eclipse source foldera, odakle ih Eclipse kopira u bin/
		     kao resurse. Tako stare klase prezive i "Clean" i mesaju se sa novim. -->
		<javac includeantruntime="false" release="8" destdir="bin">
			<!-- generisani lekser, parser i AST -->
			<src path="src/rs/ac/bg/etf/pp1"/>
			<!-- rucno pisane klase: Compiler i TestRunner -->
			<src path="test"/>
			<classpath refid="project.classpath"/>
		</javac>
	</target>

	<!-- Pokretanje svih testova iz test foldera. Za svaki .mj fajl pravi
	     istoimeni .out (standardni izlaz) i .err (izlaz gresaka). -->
	<target name="test" depends="compile">
		<java classname="rs.ac.bg.etf.pp1.TestRunner" fork="true" failonerror="true">
			<classpath>
				<!-- prevedene klase (destdir compile targeta) -->
				<pathelement path="bin"/>
				<!-- log4j.xml koji Compiler trazi preko classloader-a -->
				<pathelement path="config"/>
				<path refid="project.classpath"/>
			</classpath>
		</java>
	</target>
	
	<!-- Prevodi i odmah pokrece jedan program, sa ispisom rezultata na konzoli.

	     ant runOne -Dmj=test/68_gen_map.mj

	     Ispis prevodioca (stablo i tabela simbola) ide u test/<ime>.out, a prijave gresaka
	     na konzolu. Ako program cita sa standardnog ulaza, ulaz se zadaje kroz -Dstdin:

	     ant runOne -Dmj=test/66_gen_io.mj -Dstdin="12 34
	     Q
	     1"                                                                              -->
	<target name="runOne" depends="compile">
		<property name="mj" value="test/program.mj"/>
		<property name="stdin" value=""/>
		<basename property="mjbase" file="${mj}" suffix=".mj"/>
		<property name="obj" value="test/${mjbase}.obj"/>

		<echo>--- prevodim ${mj} ---</echo>
		<java classname="rs.ac.bg.etf.pp1.Compiler" fork="true" failonerror="true"
		      dir="${basedir}" output="test/${mjbase}.out" logError="true">
			<arg value="${mj}"/>
			<arg value="${obj}"/>
			<classpath>
				<pathelement path="bin"/>
				<pathelement path="config"/>
				<path refid="project.classpath"/>
			</classpath>
		</java>

		<echo>--- izvrsavam ${obj} ---</echo>
		<java classname="rs.etf.pp1.mj.runtime.Run" fork="true" failonerror="true"
		      dir="${basedir}" inputstring="${stdin}">
			<arg value="${obj}"/>
			<classpath>
				<pathelement location="lib/mj-runtime-1.1.jar"/>
			</classpath>
		</java>
	</target>

	<!-- Disasembler nad proizvoljnim programom:  ant disasmOne -Dmj=test/68_gen_map.mj -->
	<target name="disasmOne" depends="compile">
		<property name="mj" value="test/program.mj"/>
		<basename property="mjbase" file="${mj}" suffix=".mj"/>
		<property name="obj" value="test/${mjbase}.obj"/>

		<java classname="rs.ac.bg.etf.pp1.Compiler" fork="true" failonerror="true"
		      dir="${basedir}" output="test/${mjbase}.out" logError="true">
			<arg value="${mj}"/>
			<arg value="${obj}"/>
			<classpath>
				<pathelement path="bin"/>
				<pathelement path="config"/>
				<path refid="project.classpath"/>
			</classpath>
		</java>

		<java classname="rs.etf.pp1.mj.runtime.disasm" fork="true" dir="${basedir}">
			<arg value="${obj}"/>
			<classpath>
				<pathelement location="lib/mj-runtime-1.1.jar"/>
			</classpath>
		</java>
	</target>

	<target name="disasm">
		<java classname="rs.etf.pp1.mj.runtime.disasm" fork="true" dir="${basedir}">
			<arg value="test/program.obj"/>
			<classpath>
				<pathelement location="lib/mj-runtime-1.1.jar"/>
			</classpath>
		</java>
	</target>
	
	<target name="runObj" depends="debugObj">
		<java classname="rs.etf.pp1.mj.runtime.Run" fork="true" dir="${basedir}">
			<arg value="test/program.obj"/>
			<classpath>
				<pathelement location="lib/mj-runtime-1.1.jar"/>
			</classpath>
		</java>
	</target>
	
	<target name="debugObj" depends="disasm">
		<java classname="rs.etf.pp1.mj.runtime.Run" fork="true" dir="${basedir}">
			<arg value="test/program.obj"/>
			<arg value="-debug"/>
			<classpath>
				<pathelement location="lib/mj-runtime-1.1.jar"/>
			</classpath>
		</java>
	</target>
	
</project>	