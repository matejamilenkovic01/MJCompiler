// EXPECT: OK
// for petlja: sve kombinacije opcionih delova, ugnezdene petlje,
// break i continue.

program Petlje

int i, j, s;

{
	void main()
	{
		s = 0;

		for (i = 0; i < 10; i++) s = s + i;

		for (i = 0; i < 10; i++) {
			s = s + i;
		}

		// bez inicijalizacije
		for (; i < 10; i++) s = s + 1;

		// bez uslova
		for (i = 0; ; i++) {
			if (i > 5) break;
		}

		// bez koraka
		for (i = 0; i < 10;) {
			i++;
		}

		// svi opcioni delovi izostavljeni
		for (;;) {
			break;
		}

		// break i continue
		for (i = 0; i < 10; i++) {
			if (i == 3) continue;
			if (i == 7) break;
			s = s + i;
		}

		// ugnezdene petlje
		for (i = 0; i < 3; i++) {
			for (j = 0; j < 3; j++) {
				if (j == 1) continue;
				s = s + 1;
			}
		}

		// DesignatorStatement u zaglavlju: dodela, ++, --
		for (i = 10; i > 0; i--) s = s - 1;
	}
}
