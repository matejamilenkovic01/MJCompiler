program SemCall

int a;

{
	int f(int x, char y)
	{
		return 1;
	}

	void g()
	{
		return;
	}

	void main()
	{
		a = f(1);
		a = f(1, 2);
		a = a(1);
		f(1, 'c');
		a = g();
	}
}
