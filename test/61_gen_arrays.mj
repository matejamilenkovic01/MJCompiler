// EXPECT: OK
// Generisanje koda: kreiranje nizova, indeksiranje, length, nizovi svih tipova,
// niz kao lokalna promenljiva, inkrement elementa niza.
// OUT: 10 20 30 3
// OUT: 4
// OUT: 3
// OUT: xyz
// OUT: 10
// OUT: 25
// OUT: 21
// OUT: 19

program GenNizovi

int ni[];
char nc[];
bool nb[];
int i;

{
	void main()
		int lok[];
	{
		ni = new int[4];
		ni[0] = 10;
		ni[1] = 20;
		ni[2] = ni[0] + ni[1];
		ni[3] = ni[2] / ni[0];
		for (i = 0; i < ni.length; i++) { print(ni[i]); print(' '); }
		print(eol);                        // 10 20 30 3

		print(ni.length); print(eol);      // 4
		print(ni[ni[3]]); print(eol);      // ni[3] je 3, pa je ovo ni[3] = 3

		nc = new char[3];
		nc[0] = 'x'; nc[1] = 'y'; nc[2] = 'z';
		for (i = 0; i < 3; i++) print(nc[i]);
		print(eol);                        // xyz

		nb = new bool[2];
		nb[0] = true; nb[1] = false;
		print(nb[0]); print(nb[1]); print(eol);   // 10

		lok = new int[2];
		lok[0] = 5;
		lok[1] = lok[0] * lok[0];
		print(lok[1]); print(eol);         // 25

		ni[1]++;
		print(ni[1]); print(eol);          // 21
		ni[1]--; ni[1]--;
		print(ni[1]); print(eol);          // 19
	}
}
