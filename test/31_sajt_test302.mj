// EXPECT: OK
// Zvanicni test sa sajta (test302.mj).
// Nivo B + map iz aneksa. Pokriva: globalne funkcije i ugnezdene pozive,
// if/else if, for sa izostavljenim delovima, break, continue, || i &&.
//
// IZMENA U ODNOSU NA ORIGINAL: u originalu stoji  niz2[1 = 1;  (nedostaje
// zatvorena uglasta zagrada). To je omaska u materijalu sa sajta - fajl je
// namenjen generisanju koda pa mora biti sintaksno ispravan. Ispravljeno
// u  niz2[1] = 1;  da bi test proveravao ono sto mu je namena.

//Test 302

// IN: 1 2 3 4
// OUT: 0165
// OUT: -4
// OUT: 6012
// OUT: 6vf0
// OUT: 5
// OUT: 10
// OUT: 15
// OUT: 20
// OUT: 4
// OUT: 5
// OUT: 6
// OUT: 7
// OUT: 8
program test302

const int jedan = 1;

int i, j;
bool ibool;

int niz[], niz2[], niz3[], niz4[];
{
	
	int sum(int z, int d)
	{
		return z + d;
	}
	
	int inkrement(int a, int inc) int pom; 
	{
		if(inc == jedan) pom = 1;
		else if(inc == 2) pom = a;

		return sum(a,pom);
	}
	
	bool verify() {
		print('v');
		return false;
	}	
	
	void main()
	{
		if(1!=1) print(-6);
		else print(0);  
			
		ibool = false;
		i = 0;
		for(i=0;i<5;i++)
		{
			if(i == 2) ibool = true;
		}
		
		if(ibool)
			if(i == 5) print(1); 
			else print(-1);
		
		niz = new int[3];
		niz[0] = 1;
		niz[1] = 2;
		niz[2] = sum(niz[1], niz[0]) + 1;
		if(niz[2] == 4 || verify()) print(ord('A')); 
		else print(ord('a'));
		
		print(eol);
		i = 0;
		for(;i<10;) 
		{
			if(i == 3)
			{
				i++;
				continue;
			}
			if(i == 4) break;
			i = inkrement(i, 1);
		}
		
		if(i == 3 && verify()) print(4);
		else print(-4);  
		
		read(niz[0]);
		read(niz[1]);
		read(niz[2]);
		print(eol);
		
		print(sum (sum(niz[0], niz[1]), niz[2])); 
		
		for(i = 0; i < niz.length; i++){
			print(i);
		}
			
		print(eol); 
		print(inkrement(niz[2], 2));
		print(verify() ? 't' : 'f');
		
		niz2 = new int[5];
		niz2[0] = 0; niz2[1] = 1; niz2[2] = 2; niz2[3] = 3; niz2[4] = 4; 
		
		niz3 = niz2.map(i => i * 5);
		for(i = 0; i < niz3.length; i++){
			print(niz3[i]);
			print(eol);
		}
		
		read(j);
		niz4 = niz2.map(i => i + j);
		for(i = 0; i < niz4.length; i++){
			print(niz4[i]);
			print(eol);
		}
		
	}
}
