// EXPECT: OK
// Generisanje koda: else-if lanac, dangling else, sve varijante for petlje,
// break i continue, ugnezdene petlje.
// OUT: 2
// OUT: 9
// OUT: 10
// OUT: 5
// OUT: 10
// OUT: 4
// OUT: 18
// OUT: 6
// OUT: 6

program GenTok

int i, j, s;

{
	void main()
	{
		i = 5;
		if (i < 3) print(1);
		else if (i < 7) print(2);
		else print(3);
		print(eol);                        // 2

		// else pripada unutrasnjem if-u
		if (i > 0)
			if (i > 10) print(8); else print(9);
		print(eol);                        // 9

		s = 0;
		for (i = 0; i < 5; i++) s = s + i;
		print(s); print(eol);              // 10

		// bez inicijalizacije
		s = 0; i = 0;
		for (; i < 5; i++) s = s + 1;
		print(s); print(eol);              // 5

		// bez koraka
		s = 0;
		for (i = 0; i < 5;) { s = s + 2; i++; }
		print(s); print(eol);              // 10

		// bez ijednog dela zaglavlja
		i = 0;
		for (;;) { i++; if (i == 4) break; }
		print(i); print(eol);              // 4

		// continue preskace telo ali izvrsava korak
		s = 0;
		for (i = 0; i < 10; i++) {
			if (i == 3) continue;
			if (i == 7) break;
			s = s + i;
		}
		print(s); print(eol);              // 0+1+2+4+5+6 = 18

		// ugnezdene petlje: continue u unutrasnjoj
		s = 0;
		for (i = 0; i < 3; i++)
			for (j = 0; j < 3; j++) {
				if (j == 1) continue;
				s = s + 1;
			}
		print(s); print(eol);              // 3 * 2 = 6

		// break izlazi samo iz unutrasnje petlje
		s = 0;
		for (i = 0; i < 3; i++)
			for (j = 0; j < 5; j++) {
				if (j == 2) break;
				s = s + 1;
			}
		print(s); print(eol);              // 3 * 2 = 6
	}
}
